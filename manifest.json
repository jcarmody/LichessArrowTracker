{
  "manifest_version": 3,
  "name": "Lichess Arrow Tracker",
  "version": "2.1",
  "description": "Converts drawn arrows on Lichess into proper chess notation",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["*://lichess.org/*"],
      "js": ["chess.min.js", "content.js"],
      "run_at": "document_end"
    }
  ]
}